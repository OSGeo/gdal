<mapml- xmlns="http://www.w3.org/1999/xhtml">
    <map-head>
        <map-title>out</map-title>
        <map-meta charset="utf-8" ></map-meta>
    </map-head>
    <map-body>
        <!-- OSMTILE: standard Web Mercator (EPSG:3857) tiling scheme -->
        <map-extent units="OSMTILE" checked="checked">
            <map-input name="z" type="zoom" value="5" min="0" max="5" ></map-input>
            <!-- Tile column / row ranges covering the data extent, at zoom level 5 -->
            <map-input name="x" type="location" axis="column" units="tilematrix" min="16" max="16" ></map-input>
            <map-input name="y" type="location" axis="row" units="tilematrix" min="11" max="11" ></map-input>
            <map-link tref="./{z}/{x}/{y}.pbf" rel="tile" type="application/vnd.mapbox-vector-tile" ></map-link>
        </map-extent>
    </map-body>
</mapml->
